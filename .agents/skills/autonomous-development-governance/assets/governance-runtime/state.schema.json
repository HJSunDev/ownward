{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autonomous-development-governance/state.schema.json",
  "title": "Autonomous development governance state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "status",
    "authority_hash",
    "completion_conditions",
    "current_work_packet",
    "pending_intervention",
    "explicit_resource_constraints",
    "reusable_results",
    "next_action",
    "review"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "$ref": "#/$defs/nonEmptyString" },
    "status": {
      "enum": [
        "running",
        "product_decision_required",
        "external_input_required",
        "complete"
      ]
    },
    "authority_hash": { "$ref": "#/$defs/hash" },
    "completion_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition_id", "status"],
        "properties": {
          "condition_id": { "$ref": "#/$defs/nonEmptyString" },
          "status": { "enum": ["unmet", "in_progress", "met", "evidence_insufficient"] },
          "evidence_ids": {
            "type": "array",
            "items": { "$ref": "#/$defs/nonEmptyString" },
            "uniqueItems": true
          }
        }
      }
    },
    "current_work_packet": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/workPacket" }
      ]
    },
    "pending_intervention": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/pendingIntervention" }
      ]
    },
    "explicit_resource_constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constraint_id", "source", "measure", "limit"],
        "properties": {
          "constraint_id": { "$ref": "#/$defs/nonEmptyString" },
          "source": { "$ref": "#/$defs/nonEmptyString" },
          "measure": { "$ref": "#/$defs/nonEmptyString" },
          "limit": {}
        }
      }
    },
    "reusable_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["result_id", "scope", "evidence_path", "input_hash"],
        "properties": {
          "result_id": { "$ref": "#/$defs/nonEmptyString" },
          "scope": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
          "evidence_path": { "$ref": "#/$defs/nonEmptyString" },
          "input_hash": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "next_action": { "type": ["string", "null"] },
    "review": { "$ref": "#/$defs/reviewState" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["running", "complete"] } } },
      "then": { "properties": { "pending_intervention": { "type": "null" } } }
    },
    {
      "if": { "properties": { "status": { "const": "product_decision_required" } } },
      "then": { "properties": { "pending_intervention": { "type": "object", "properties": { "kind": { "const": "product_decision" } } } } }
    },
    {
      "if": { "properties": { "status": { "const": "external_input_required" } } },
      "then": { "properties": { "pending_intervention": { "type": "object", "properties": { "kind": { "enum": ["permission", "credential", "external_state"] } } } } }
    }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "description", "reached"],
      "properties": {
        "checkpoint_id": { "$ref": "#/$defs/nonEmptyString" },
        "description": { "$ref": "#/$defs/nonEmptyString" },
        "reached": { "type": "boolean" }
      }
    },
    "approval": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "review_id",
            "trigger_instance_id",
            "review_snapshot_hash",
            "valid_until_checkpoint"
          ],
          "properties": {
            "status": { "const": "approved" },
            "review_id": { "$ref": "#/$defs/nonEmptyString" },
            "trigger_instance_id": { "$ref": "#/$defs/nonEmptyString" },
            "review_snapshot_hash": { "$ref": "#/$defs/hash" },
            "valid_until_checkpoint": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ]
    },
    "workPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "condition_id",
        "objective",
        "value",
        "allowed_scope",
        "excluded_scope",
        "expected_evidence",
        "evidence_checkpoint",
        "plan_hash",
        "approval",
        "started_at",
        "last_evidence_at",
        "checkpoint",
        "failure_signatures",
        "failure_events",
        "failure_repairs"
      ],
      "properties": {
        "packet_id": { "$ref": "#/$defs/nonEmptyString" },
        "condition_id": { "$ref": "#/$defs/nonEmptyString" },
        "objective": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "$ref": "#/$defs/nonEmptyString" },
        "allowed_scope": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "minItems": 1 },
        "excluded_scope": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "expected_evidence": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "minItems": 1 },
        "evidence_checkpoint": { "$ref": "#/$defs/checkpoint" },
        "plan_hash": { "$ref": "#/$defs/hash" },
        "approval": { "$ref": "#/$defs/approval" },
        "started_at": { "$ref": "#/$defs/nonEmptyString" },
        "last_evidence_at": { "type": ["string", "null"] },
        "checkpoint": { "type": ["string", "null"] },
        "failure_signatures": { "type": "array", "maxItems": 0 },
        "failure_events": { "type": "array", "items": { "$ref": "#/$defs/failureEvent" } },
        "failure_repairs": { "type": "array", "items": { "$ref": "#/$defs/failureRepair" } }
      }
    },
    "failureEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "signature", "work_packet_id", "source_kind", "source_execution", "tool_use_id", "repair_generation", "evidence_hash", "trust", "occurred_at"],
      "properties": {
        "event_id": { "$ref": "#/$defs/nonEmptyString" },
        "signature": { "$ref": "#/$defs/nonEmptyString" },
        "work_packet_id": { "$ref": "#/$defs/nonEmptyString" },
        "source_kind": { "enum": ["codex_hook", "governed_run", "legacy"] },
        "source_execution": { "$ref": "#/$defs/nonEmptyString" },
        "tool_use_id": { "$ref": "#/$defs/nonEmptyString" },
        "repair_generation": { "type": "integer", "minimum": 0 },
        "evidence_hash": { "$ref": "#/$defs/hash" },
        "known_evidence_ids": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "repository_identity": { "$ref": "#/$defs/hash" },
        "candidate_identity": { "$ref": "#/$defs/hash" },
        "config_identity": { "$ref": "#/$defs/hash" },
        "runtime_identity": { "$ref": "#/$defs/hash" },
        "trust": { "enum": ["verified", "legacy_unverified"] },
        "occurred_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [{
        "if": { "properties": { "trust": { "const": "verified" } } },
        "then": { "required": ["known_evidence_ids", "repository_identity", "candidate_identity", "config_identity", "runtime_identity"] }
      }]
    },
    "failureRepair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repair_id", "signature", "previous_event_id", "work_packet_id", "repair_generation", "repository_identity", "candidate_identity", "config_identity", "runtime_identity", "evidence_ids", "recorded_at"],
      "properties": {
        "repair_id": { "$ref": "#/$defs/nonEmptyString" },
        "signature": { "$ref": "#/$defs/nonEmptyString" },
        "previous_event_id": { "$ref": "#/$defs/nonEmptyString" },
        "work_packet_id": { "$ref": "#/$defs/nonEmptyString" },
        "repair_generation": { "type": "integer", "minimum": 1 },
        "repository_identity": { "$ref": "#/$defs/hash" },
        "candidate_identity": { "$ref": "#/$defs/hash" },
        "config_identity": { "$ref": "#/$defs/hash" },
        "runtime_identity": { "$ref": "#/$defs/hash" },
        "evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } },
        "recorded_at": { "type": "string", "format": "date-time" }
      }
    },
    "interventionResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_turn_id", "summary", "evidence_refs", "submitted_at"],
      "properties": {
        "source_turn_id": { "$ref": "#/$defs/nonEmptyString" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
        "submitted_at": { "type": "string", "format": "date-time" }
      }
    },
    "pendingIntervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_id", "source_review_id", "kind", "fact", "exhausted_paths", "minimum_user_input", "status", "resolution"],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/nonEmptyString" },
        "source_review_id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["product_decision", "permission", "credential", "external_state"] },
        "fact": { "$ref": "#/$defs/nonEmptyString" },
        "exhausted_paths": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "minItems": 1, "uniqueItems": true },
        "minimum_user_input": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["awaiting_user", "resolution_pending_review"] },
        "resolution": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/interventionResolution" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "awaiting_user" } } },
          "then": { "properties": { "resolution": { "type": "null" } } }
        },
        {
          "if": { "properties": { "status": { "const": "resolution_pending_review" } } },
          "then": { "properties": { "resolution": { "$ref": "#/$defs/interventionResolution" } } }
        }
      ]
    },
    "reviewState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "review_id",
        "trigger_instance_id",
        "fixed_review_generation",
        "review_snapshot_hash",
        "trigger",
        "decision_path"
      ],
      "properties": {
        "required": { "type": "boolean" },
        "review_id": { "type": ["string", "null"] },
        "trigger_instance_id": { "type": ["string", "null"] },
        "fixed_review_generation": { "type": "integer", "minimum": 0 },
        "review_snapshot_hash": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/hash" }
          ]
        },
        "trigger": { "type": ["string", "null"] },
        "decision_path": { "type": ["string", "null"] }
      }
    }
  }
}
