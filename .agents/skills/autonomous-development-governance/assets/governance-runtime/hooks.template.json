{
  "description": "Deterministic advisory governance hooks. Replace command placeholders during installation.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "{{governance_hook_command}} hook session-start",
            "commandWindows": "{{governance_hook_command_windows}} hook session-start",
            "timeout": 10,
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{governance_hook_command}} hook user-prompt-submit",
            "commandWindows": "{{governance_hook_command_windows}} hook user-prompt-submit",
            "timeout": 10,
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^{{governor_agent_name}}$",
        "hooks": [
          {
            "type": "command",
            "command": "{{governance_hook_command}} hook subagent-start",
            "commandWindows": "{{governance_hook_command_windows}} hook subagent-start",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^{{governor_agent_name}}$",
        "hooks": [
          {
            "type": "command",
            "command": "{{governance_hook_command}} hook subagent-stop",
            "commandWindows": "{{governance_hook_command_windows}} hook subagent-stop",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
