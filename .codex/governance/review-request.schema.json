{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ownward.local/schemas/governance-review-request-v3.json",
  "title": "Ownward Advisory Governor Review Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "trigger_instance_id", "review_snapshot_hash", "trigger", "authority_paths", "authority_refs", "completion_definition_paths", "repository_snapshot", "state_path", "current_condition_id", "current_focus", "pending_intervention", "resource_facts", "recent_checkpoint", "evidence_refs", "progress_delta", "created_at"],
  "properties": {
    "schema_version": { "const": 3 },
    "review_id": { "$ref": "#/$defs/nonEmpty" },
    "trigger_instance_id": { "$ref": "#/$defs/nonEmpty" },
    "review_snapshot_hash": { "$ref": "#/$defs/hash" },
    "trigger": { "$ref": "#/$defs/trigger" },
    "authority_paths": { "$ref": "#/$defs/stringList" },
    "authority_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/authorityRef" } },
    "completion_definition_paths": { "$ref": "#/$defs/stringList" },
    "repository_snapshot": { "$ref": "#/$defs/repository" },
    "state_path": { "$ref": "#/$defs/nonEmpty" },
    "current_condition_id": { "type": ["string", "null"] },
    "current_focus": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/focus" }] },
    "pending_intervention": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pendingIntervention" }] },
    "resource_facts": { "type": "array", "items": { "$ref": "#/$defs/resourceFact" } },
    "recent_checkpoint": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/recentCheckpoint" }] },
    "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
    "progress_delta": { "$ref": "#/$defs/progressDelta" },
    "created_at": { "$ref": "#/$defs/nonEmpty" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stringList": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" }, "uniqueItems": true },
    "trigger": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "type", "source_id", "reason"],
      "properties": { "kind": { "enum": ["fixed", "event", "legacy"] }, "type": { "$ref": "#/$defs/nonEmpty" }, "source_id": { "$ref": "#/$defs/nonEmpty" }, "reason": { "$ref": "#/$defs/nonEmpty" } }
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "head_commit"],
      "properties": { "root": { "$ref": "#/$defs/nonEmpty" }, "head_commit": { "$ref": "#/$defs/nonEmpty" } }
    },
    "focus": {
      "type": "object", "additionalProperties": false,
      "required": ["focus_id", "condition_id", "objective", "value", "involved_scope", "expected_evidence", "checkpoint_id", "checkpoint_description", "snapshot_hash", "execution_id"],
      "properties": {
        "focus_id": { "$ref": "#/$defs/nonEmpty" }, "condition_id": { "$ref": "#/$defs/nonEmpty" }, "objective": { "$ref": "#/$defs/nonEmpty" }, "value": { "$ref": "#/$defs/nonEmpty" },
        "involved_scope": { "$ref": "#/$defs/stringList" }, "expected_evidence": { "$ref": "#/$defs/stringList" }, "checkpoint_id": { "$ref": "#/$defs/nonEmpty" }, "checkpoint_description": { "$ref": "#/$defs/nonEmpty" }, "snapshot_hash": { "$ref": "#/$defs/hash" }, "execution_id": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "authorityRef": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "hash"],
      "properties": { "path": { "$ref": "#/$defs/nonEmpty" }, "hash": { "$ref": "#/$defs/hash" } }
    },
    "progressDelta": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline_id", "critical_condition_id", "critical_condition_status", "expected_checkpoint_id", "new_evidence_ids", "reused_evidence_ids", "invalidated_evidence_ids", "execution_identity_changed", "checkpoint_outcome", "next_investment", "net_progress"],
      "properties": {
        "baseline_id": { "type": ["string", "null"] }, "critical_condition_id": { "$ref": "#/$defs/nonEmpty" }, "critical_condition_status": { "$ref": "#/$defs/nonEmpty" },
        "expected_checkpoint_id": { "type": ["string", "null"] }, "new_evidence_ids": { "$ref": "#/$defs/stringList" }, "reused_evidence_ids": { "$ref": "#/$defs/stringList" }, "invalidated_evidence_ids": { "$ref": "#/$defs/stringList" },
        "execution_identity_changed": { "type": "boolean" }, "checkpoint_outcome": { "enum": ["not_applicable", "pending", "passed", "failed"] }, "next_investment": { "$ref": "#/$defs/nonEmpty" }, "net_progress": { "enum": ["initial", "advanced", "zero", "regressed"] }
      }
    },
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["source_turn_id", "summary", "evidence_refs", "submitted_at"],
      "properties": { "source_turn_id": { "$ref": "#/$defs/nonEmpty" }, "summary": { "$ref": "#/$defs/nonEmpty" }, "evidence_refs": { "$ref": "#/$defs/stringList" }, "submitted_at": { "$ref": "#/$defs/nonEmpty" } }
    },
    "pendingIntervention": {
      "type": "object", "additionalProperties": false,
      "required": ["intervention_id", "source_review_id", "kind", "fact", "exhausted_paths", "minimum_user_input", "status", "resolution"],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/nonEmpty" }, "source_review_id": { "$ref": "#/$defs/nonEmpty" }, "kind": { "$ref": "#/$defs/nonEmpty" }, "fact": { "$ref": "#/$defs/nonEmpty" },
        "exhausted_paths": { "$ref": "#/$defs/stringList" }, "minimum_user_input": { "$ref": "#/$defs/nonEmpty" }, "status": { "enum": ["awaiting_user", "resolution_pending_review"] },
        "resolution": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/resolution" }] }
      }
    },
    "resourceFact": {
      "type": "object", "additionalProperties": false,
      "required": ["measure", "value", "unit", "source"],
      "properties": { "measure": { "$ref": "#/$defs/nonEmpty" }, "value": true, "unit": { "$ref": "#/$defs/nonEmpty" }, "source": { "$ref": "#/$defs/nonEmpty" } }
    },
    "recentCheckpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpoint_id", "description", "evidence_ids"],
      "properties": { "checkpoint_id": { "$ref": "#/$defs/nonEmpty" }, "description": { "$ref": "#/$defs/nonEmpty" }, "evidence_ids": { "$ref": "#/$defs/stringList" } }
    },
    "evidenceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "path", "hash"],
      "properties": { "evidence_id": { "$ref": "#/$defs/nonEmpty" }, "path": { "$ref": "#/$defs/nonEmpty" }, "hash": { "$ref": "#/$defs/hash" } }
    }
  }
}
