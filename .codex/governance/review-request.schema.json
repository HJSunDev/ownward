{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ownward.local/governance/review-request.schema.json",
  "title": "Ownward Governor review request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "trigger_instance_id", "review_snapshot_hash", "trigger", "authority_paths", "completion_definition_paths", "repository_snapshot", "state_path", "current_condition_id", "current_work_packet", "pending_intervention", "resource_facts", "recent_checkpoint", "evidence_refs", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "review_id": { "$ref": "#/$defs/nonEmptyString" },
    "trigger_instance_id": { "$ref": "#/$defs/nonEmptyString" },
    "review_snapshot_hash": { "$ref": "#/$defs/hash" },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": { "kind": { "enum": ["fixed", "event"] }, "reason": { "$ref": "#/$defs/nonEmptyString" } }
    },
    "authority_paths": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "minItems": 1, "uniqueItems": true },
    "completion_definition_paths": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "minItems": 1, "uniqueItems": true },
    "repository_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "head_commit", "working_tree_hash"],
      "properties": {
        "root": { "$ref": "#/$defs/nonEmptyString" },
        "head_commit": { "$ref": "#/$defs/nonEmptyString" },
        "working_tree_hash": { "$ref": "#/$defs/hash" }
      }
    },
    "state_path": { "$ref": "#/$defs/nonEmptyString" },
    "current_condition_id": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/nonEmptyString" }] },
    "current_work_packet": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/workPacket" }] },
    "pending_intervention": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pendingIntervention" }] },
    "resource_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["measure", "value", "unit", "source"],
        "properties": {
          "measure": { "$ref": "#/$defs/nonEmptyString" },
          "value": { "type": ["number", "string"] },
          "unit": { "$ref": "#/$defs/nonEmptyString" },
          "source": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "recent_checkpoint": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkpoint_id", "description", "evidence_ids"],
          "properties": {
            "checkpoint_id": { "$ref": "#/$defs/nonEmptyString" },
            "description": { "$ref": "#/$defs/nonEmptyString" },
            "evidence_ids": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true }
          }
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "path", "hash"],
        "properties": {
          "evidence_id": { "$ref": "#/$defs/nonEmptyString" },
          "path": { "$ref": "#/$defs/nonEmptyString" },
          "hash": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$" },
    "interventionResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_turn_id", "summary", "evidence_refs", "submitted_at"],
      "properties": {
        "source_turn_id": { "$ref": "#/$defs/nonEmptyString" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
        "submitted_at": { "type": "string", "format": "date-time" }
      }
    },
    "pendingIntervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intervention_id", "source_review_id", "kind", "fact", "exhausted_paths", "minimum_user_input", "status", "resolution"],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/nonEmptyString" },
        "source_review_id": { "$ref": "#/$defs/nonEmptyString" },
        "kind": { "enum": ["product_decision", "permission", "credential", "external_state"] },
        "fact": { "$ref": "#/$defs/nonEmptyString" },
        "exhausted_paths": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "minItems": 1, "uniqueItems": true },
        "minimum_user_input": { "$ref": "#/$defs/nonEmptyString" },
        "status": { "enum": ["awaiting_user", "resolution_pending_review"] },
        "resolution": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/interventionResolution" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "awaiting_user" } } },
          "then": { "properties": { "resolution": { "type": "null" } } }
        },
        {
          "if": { "properties": { "status": { "const": "resolution_pending_review" } } },
          "then": { "properties": { "resolution": { "$ref": "#/$defs/interventionResolution" } } }
        }
      ]
    },
    "workPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_id", "condition_id", "objective", "value", "allowed_scope", "excluded_scope", "expected_evidence", "checkpoint_id", "checkpoint_description", "plan_hash"],
      "properties": {
        "packet_id": { "$ref": "#/$defs/nonEmptyString" },
        "condition_id": { "$ref": "#/$defs/nonEmptyString" },
        "objective": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "$ref": "#/$defs/nonEmptyString" },
        "allowed_scope": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "minItems": 1 },
        "excluded_scope": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" } },
        "expected_evidence": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "minItems": 1 },
        "checkpoint_id": { "$ref": "#/$defs/nonEmptyString" },
        "checkpoint_description": { "$ref": "#/$defs/nonEmptyString" },
        "plan_hash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
