{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ownward.local/schemas/governance-state-v3.json",
  "title": "Ownward Advisory Governance State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "authority_hash", "completion_conditions", "current_focus", "pending_intervention", "explicit_resource_constraints", "reusable_results", "next_action", "activation_source_id", "review_baseline", "invalidated_evidence", "last_diagnostic", "review", "owner", "handoff"],
  "properties": {
    "schema_version": { "const": 3 },
    "run_id": { "$ref": "#/$defs/nonEmpty" },
    "status": { "enum": ["active", "awaiting_user", "complete"] },
    "authority_hash": { "$ref": "#/$defs/hash" },
    "completion_conditions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/completionCondition" } },
    "current_focus": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/executionSnapshot" }] },
    "pending_intervention": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pendingIntervention" }] },
    "explicit_resource_constraints": { "type": "array", "items": { "$ref": "#/$defs/resourceConstraint" } },
    "reusable_results": { "type": "array", "items": { "$ref": "#/$defs/reusableResult" } },
    "next_action": { "type": ["string", "null"] },
    "activation_source_id": { "type": ["string", "null"] },
    "review_baseline": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/reviewBaseline" }] },
    "invalidated_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidenceInvalidation" } },
    "last_diagnostic": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/runtimeDiagnostic" }] },
    "review": { "$ref": "#/$defs/reviewState" },
    "owner": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/owner" }] },
    "handoff": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/handoff" }] }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stringList": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" }, "uniqueItems": true },
    "completionCondition": {
      "type": "object", "additionalProperties": false,
      "required": ["condition_id", "status"],
      "properties": { "condition_id": { "$ref": "#/$defs/nonEmpty" }, "status": { "enum": ["unmet", "in_progress", "evidence_insufficient", "met"] }, "evidence_ids": { "$ref": "#/$defs/stringList" } }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpoint_id", "description", "reached"],
      "properties": { "checkpoint_id": { "$ref": "#/$defs/nonEmpty" }, "description": { "$ref": "#/$defs/nonEmpty" }, "reached": { "type": "boolean" } }
    },
    "failureEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "signature", "focus_id", "source_kind", "source_execution", "tool_use_id", "repair_generation", "evidence_hash", "known_evidence_ids", "trust", "occurred_at"],
      "properties": {
        "event_id": { "$ref": "#/$defs/nonEmpty" }, "signature": { "$ref": "#/$defs/nonEmpty" }, "focus_id": { "$ref": "#/$defs/nonEmpty" },
        "source_kind": { "$ref": "#/$defs/nonEmpty" }, "source_execution": { "$ref": "#/$defs/nonEmpty" }, "tool_use_id": { "$ref": "#/$defs/nonEmpty" },
        "repair_generation": { "type": "integer", "minimum": 0 }, "evidence_hash": { "$ref": "#/$defs/hash" }, "known_evidence_ids": { "$ref": "#/$defs/stringList" },
        "repository_identity": { "type": "string" }, "candidate_identity": { "type": "string" }, "config_identity": { "type": "string" }, "runtime_identity": { "type": "string" },
        "trust": { "enum": ["verified", "legacy_unverified"] }, "occurred_at": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "failureRepair": {
      "type": "object", "additionalProperties": false,
      "required": ["repair_id", "signature", "previous_event_id", "focus_id", "repair_generation", "repository_identity", "candidate_identity", "config_identity", "runtime_identity", "evidence_ids", "recorded_at"],
      "properties": {
        "repair_id": { "$ref": "#/$defs/nonEmpty" }, "signature": { "$ref": "#/$defs/nonEmpty" }, "previous_event_id": { "$ref": "#/$defs/nonEmpty" }, "focus_id": { "$ref": "#/$defs/nonEmpty" },
        "repair_generation": { "type": "integer", "minimum": 1 }, "repository_identity": { "$ref": "#/$defs/nonEmpty" }, "candidate_identity": { "$ref": "#/$defs/nonEmpty" },
        "config_identity": { "$ref": "#/$defs/nonEmpty" }, "runtime_identity": { "$ref": "#/$defs/nonEmpty" }, "evidence_ids": { "$ref": "#/$defs/stringList" }, "recorded_at": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "executionSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["focus_id", "condition_id", "objective", "value", "involved_scope", "expected_evidence", "evidence_checkpoint", "snapshot_hash", "execution_id", "started_at", "last_evidence_at", "checkpoint", "failure_events", "failure_repairs"],
      "properties": {
        "focus_id": { "$ref": "#/$defs/nonEmpty" }, "condition_id": { "$ref": "#/$defs/nonEmpty" }, "objective": { "$ref": "#/$defs/nonEmpty" }, "value": { "$ref": "#/$defs/nonEmpty" },
        "involved_scope": { "$ref": "#/$defs/stringList" }, "expected_evidence": { "$ref": "#/$defs/stringList" }, "evidence_checkpoint": { "$ref": "#/$defs/checkpoint" },
        "snapshot_hash": { "$ref": "#/$defs/hash" }, "execution_id": { "$ref": "#/$defs/nonEmpty" }, "started_at": { "$ref": "#/$defs/nonEmpty" }, "last_evidence_at": { "type": ["string", "null"] }, "checkpoint": { "type": ["string", "null"] },
        "failure_events": { "type": "array", "items": { "$ref": "#/$defs/failureEvent" } }, "failure_repairs": { "type": "array", "items": { "$ref": "#/$defs/failureRepair" } }
      }
    },
    "reviewResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["review_id", "disposition", "reason", "next_validation_point", "responded_at"],
      "properties": { "review_id": { "$ref": "#/$defs/nonEmpty" }, "disposition": { "enum": ["adopt", "decline", "acknowledge"] }, "reason": { "$ref": "#/$defs/nonEmpty" }, "next_validation_point": { "$ref": "#/$defs/nonEmpty" }, "responded_at": { "$ref": "#/$defs/nonEmpty" } }
    },
    "reviewState": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "review_id", "trigger_instance_id", "fixed_review_generation", "review_snapshot_hash", "trigger", "response", "pending", "governor_agent_id"],
      "properties": {
        "status": { "enum": ["idle", "requested", "feedback_ready", "superseded", "responded", "missed"] }, "review_id": { "type": ["string", "null"] }, "trigger_instance_id": { "type": ["string", "null"] },
        "fixed_review_generation": { "type": "integer", "minimum": 0 }, "review_snapshot_hash": { "type": ["string", "null"] }, "trigger": { "type": ["string", "null"] },
        "response": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/reviewResponse" }] },
        "pending": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pendingReview" }] },
        "governor_agent_id": { "type": ["string", "null"] }
      }
    },
    "evidenceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "path", "hash"],
      "properties": { "evidence_id": { "$ref": "#/$defs/nonEmpty" }, "path": { "$ref": "#/$defs/nonEmpty" }, "hash": { "$ref": "#/$defs/hash" } }
    },
    "reviewBaseline": {
      "type": "object", "additionalProperties": false,
      "required": ["baseline_id", "review_id", "authority_hash", "focus_id", "focus_snapshot_hash", "focus_execution_id", "conditions", "evidence_refs", "checkpoint_id", "checkpoint_outcome", "established_at"],
      "properties": {
        "baseline_id": { "$ref": "#/$defs/nonEmpty" }, "review_id": { "$ref": "#/$defs/nonEmpty" }, "authority_hash": { "$ref": "#/$defs/hash" },
        "focus_id": { "type": ["string", "null"] }, "focus_snapshot_hash": { "type": ["string", "null"] }, "focus_execution_id": { "type": ["string", "null"] },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/completionCondition" } }, "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "checkpoint_id": { "type": ["string", "null"] }, "checkpoint_outcome": { "enum": ["not_applicable", "pending", "passed", "failed"] }, "established_at": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "evidenceInvalidation": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "previous_hash", "invalidated_at"],
      "properties": { "evidence_id": { "$ref": "#/$defs/nonEmpty" }, "previous_hash": { "$ref": "#/$defs/hash" }, "invalidated_at": { "$ref": "#/$defs/nonEmpty" } }
    },
    "pendingReview": {
      "type": "object", "additionalProperties": false,
      "required": ["trigger_types", "source_ids", "facts_hash", "reason"],
      "properties": { "trigger_types": { "$ref": "#/$defs/stringList" }, "source_ids": { "$ref": "#/$defs/stringList" }, "facts_hash": { "$ref": "#/$defs/hash" }, "reason": { "$ref": "#/$defs/nonEmpty" } }
    },
    "runtimeDiagnostic": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "summary", "occurred_at"],
      "properties": { "source": { "$ref": "#/$defs/nonEmpty" }, "summary": { "$ref": "#/$defs/nonEmpty" }, "occurred_at": { "$ref": "#/$defs/nonEmpty" } }
    },
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["source_turn_id", "summary", "evidence_refs", "submitted_at"],
      "properties": { "source_turn_id": { "$ref": "#/$defs/nonEmpty" }, "summary": { "$ref": "#/$defs/nonEmpty" }, "evidence_refs": { "$ref": "#/$defs/stringList" }, "submitted_at": { "$ref": "#/$defs/nonEmpty" } }
    },
    "pendingIntervention": {
      "type": "object", "additionalProperties": false,
      "required": ["intervention_id", "source_review_id", "kind", "fact", "exhausted_paths", "minimum_user_input", "status", "resolution"],
      "properties": {
        "intervention_id": { "$ref": "#/$defs/nonEmpty" }, "source_review_id": { "$ref": "#/$defs/nonEmpty" }, "kind": { "$ref": "#/$defs/nonEmpty" }, "fact": { "$ref": "#/$defs/nonEmpty" },
        "exhausted_paths": { "$ref": "#/$defs/stringList" }, "minimum_user_input": { "$ref": "#/$defs/nonEmpty" }, "status": { "enum": ["awaiting_user", "resolution_pending_review"] },
        "resolution": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/resolution" }] }
      }
    },
    "resourceConstraint": {
      "type": "object", "additionalProperties": false,
      "required": ["constraint_id", "source", "measure", "limit"],
      "properties": { "constraint_id": { "$ref": "#/$defs/nonEmpty" }, "source": { "$ref": "#/$defs/nonEmpty" }, "measure": { "$ref": "#/$defs/nonEmpty" }, "limit": true }
    },
    "reusableResult": {
      "type": "object", "additionalProperties": false,
      "required": ["result_id", "scope", "evidence_path", "input_hash"],
      "properties": { "result_id": { "$ref": "#/$defs/nonEmpty" }, "scope": { "$ref": "#/$defs/stringList" }, "evidence_path": { "$ref": "#/$defs/nonEmpty" }, "input_hash": { "$ref": "#/$defs/hash" } }
    },
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["session_id", "transcript_path", "owner_epoch", "acquired_at"],
      "properties": { "session_id": { "$ref": "#/$defs/nonEmpty" }, "transcript_path": { "type": "string" }, "owner_epoch": { "type": "integer", "minimum": 1 }, "acquired_at": { "$ref": "#/$defs/nonEmpty" } }
    },
    "handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["handoff_id", "token_hash", "source_session_id", "source_epoch", "target_thread_id", "status", "created_at", "expires_at"],
      "properties": { "handoff_id": { "$ref": "#/$defs/nonEmpty" }, "token_hash": { "$ref": "#/$defs/hash" }, "source_session_id": { "$ref": "#/$defs/nonEmpty" }, "source_epoch": { "type": "integer", "minimum": 1 }, "target_thread_id": { "type": "string" }, "status": { "enum": ["prepared", "bound"] }, "created_at": { "$ref": "#/$defs/nonEmpty" }, "expires_at": { "$ref": "#/$defs/nonEmpty" } }
    }
  }
}
