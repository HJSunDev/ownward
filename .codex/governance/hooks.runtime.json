{
  "description": "Ownward advisory governance hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \".codex/governance/governance-hook.sh\" hook session-start",
            "commandWindows": "cmd.exe /d /c .codex\\governance\\governance-hook.cmd hook session-start",
            "timeout": 10,
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \".codex/governance/governance-hook.sh\" hook user-prompt-submit",
            "commandWindows": "cmd.exe /d /c .codex\\governance\\governance-hook.cmd hook user-prompt-submit",
            "timeout": 10,
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^governor$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \".codex/governance/governance-hook.sh\" hook subagent-start",
            "commandWindows": "cmd.exe /d /c .codex\\governance\\governance-hook.cmd hook subagent-start",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^governor$",
        "hooks": [
          {
            "type": "command",
            "command": "sh \".codex/governance/governance-hook.sh\" hook subagent-stop",
            "commandWindows": "cmd.exe /d /c .codex\\governance\\governance-hook.cmd hook subagent-stop",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
