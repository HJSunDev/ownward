{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ownward.local/schemas/governance-review-v3.json",
  "title": "Ownward Advisory Governor Feedback",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_id", "trigger_instance_id", "review_snapshot_hash", "recommendation", "macro_assessment", "highest_priority_gap", "path_assessment", "preserved_result_ids", "suggested_invalidations", "validated_evidence_ids", "suggested_focus", "external_input", "authority_claims", "assumptions", "reason"],
  "properties": {
    "review_id": { "$ref": "#/$defs/nonEmpty" },
    "trigger_instance_id": { "$ref": "#/$defs/nonEmpty" },
    "review_snapshot_hash": { "$ref": "#/$defs/hash" },
    "recommendation": { "enum": ["continue", "adjust", "stage_complete", "goal_complete", "product_decision_needed", "external_input_needed"] },
    "macro_assessment": { "$ref": "#/$defs/macroAssessment" },
    "highest_priority_gap": { "type": ["string", "null"] },
    "path_assessment": { "$ref": "#/$defs/pathAssessment" },
    "preserved_result_ids": { "$ref": "#/$defs/stringList" },
    "suggested_invalidations": { "$ref": "#/$defs/stringList" },
    "validated_evidence_ids": { "$ref": "#/$defs/stringList" },
    "suggested_focus": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/suggestedFocus" }] },
    "external_input": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/externalInput" }] },
    "authority_claims": { "type": "array", "items": { "$ref": "#/$defs/authorityClaim" } },
    "assumptions": { "type": "array", "items": { "$ref": "#/$defs/assumption" } },
    "reason": { "$ref": "#/$defs/nonEmpty" }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "stringList": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" }, "uniqueItems": true },
    "macroAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["overall_progress", "evidence_support", "completed", "unmet"],
      "properties": { "overall_progress": { "$ref": "#/$defs/nonEmpty" }, "evidence_support": { "$ref": "#/$defs/nonEmpty" }, "completed": { "$ref": "#/$defs/stringList" }, "unmet": { "$ref": "#/$defs/stringList" } }
    },
    "pathAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["necessary", "efficient", "optimal", "problems", "better_plan"],
      "properties": { "necessary": { "type": "boolean" }, "efficient": { "type": "boolean" }, "optimal": { "type": "boolean" }, "problems": { "$ref": "#/$defs/stringList" }, "better_plan": { "$ref": "#/$defs/stringList" } }
    },
    "suggestedFocus": {
      "type": "object", "additionalProperties": false,
      "required": ["focus_id", "condition_id", "objective", "value", "involved_scope", "expected_evidence", "checkpoint_id", "checkpoint_description"],
      "properties": {
        "focus_id": { "$ref": "#/$defs/nonEmpty" }, "condition_id": { "$ref": "#/$defs/nonEmpty" }, "objective": { "$ref": "#/$defs/nonEmpty" }, "value": { "$ref": "#/$defs/nonEmpty" },
        "involved_scope": { "$ref": "#/$defs/stringList" }, "expected_evidence": { "$ref": "#/$defs/stringList" }, "checkpoint_id": { "$ref": "#/$defs/nonEmpty" }, "checkpoint_description": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "externalInput": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "fact", "exhausted_paths", "minimum_user_input"],
      "properties": { "kind": { "enum": ["product_decision", "permission", "credential", "external_state"] }, "fact": { "$ref": "#/$defs/nonEmpty" }, "exhausted_paths": { "$ref": "#/$defs/stringList" }, "minimum_user_input": { "$ref": "#/$defs/nonEmpty" } }
    },
    "authorityClaim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim", "source_path", "stable_locator", "source_hash"],
      "properties": { "claim": { "$ref": "#/$defs/nonEmpty" }, "source_path": { "$ref": "#/$defs/nonEmpty" }, "stable_locator": { "type": "string", "pattern": "^(heading|anchor|json-pointer):.+$" }, "source_hash": { "$ref": "#/$defs/hash" } }
    },
    "assumption": {
      "type": "object", "additionalProperties": false,
      "required": ["statement", "impact"],
      "properties": { "statement": { "$ref": "#/$defs/nonEmpty" }, "impact": { "$ref": "#/$defs/nonEmpty" } }
    }
  }
}
