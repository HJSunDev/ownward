    "schema": "ownward.pending-ready-retrieval-representation/v1",
    "pending": {
      "provenance_type": "current-authority-body",
      "producer": "v2-candidate-representation-lifecycle",
      "model": "EmbeddingGemma",
      "space": "resolved-from-sealed-vector-capability",
      "revision": "exact-current-authority-revision",
      "semantic_work_source": "explicit-relations-plus-current-authority-lexical-candidates",
      "vector_generation": "sealed-one-per-current-revision-background-job",
      "query_behavior": "join-the-current-revision-job-before-exact-semantic-search; on verified generation failure preserve existing lexical failure-open behavior"
    },
    "ready": {
      "provenance_type": "accepted-semantic-receipt-plus-current-authority-body-vector",
      "producer": "v2-candidate-representation-lifecycle",
      "model": "semantic-capability-from-validated-submission plus EmbeddingGemma",
      "space": "same-sealed-vector-space-as-current-product",
      "revision": "exact-current-authority-revision",
      "promotion": "atomic-derived-record-write-after-both-validated-semantic-receipt-and-current-revision-vector-are-complete",
      "query_behavior": "same-exact-query-vector-and-document-vector-ranking-as-the-current-ready-path"
    },
    "unique_valid_rule": "For one asset revision there is one durable current representation state. A pending job is subordinate to that record, and only the matching current revision may promote it to ready.",
    "transitions": [
      "create-or-update-authority -> durable-pending-record -> sealed-vector-job",
      "pending-query -> join-matching-job -> exact-semantic-query-or-existing-lexical-failure-open",
      "semantic-work -> immutable-explicit-plus-lexical-WorkReference",
      "semantic-submit -> validate-receipt -> join-matching-vector -> atomic-ready-record",
      "concurrent-update -> invalidate-old-job-result -> new-revision-pending",
      "generation-failure -> durable-pending-error-with-no-false-ready-state",
      "restart -> recover-pending-from-record-and-regenerate-on-demand",
      "rebuild -> rebuild-one-current-revision-job-without-reading-stale-derived-results",
      "rollback -> generation-level-pointer-rollback-without-second-authority",
      "stale-cleanup -> discard-job-result-and-obsolete-record-for-noncurrent-revision"
    ],
    "forbidden": [
      "second-authority-or-parallel-ready-truth",
      "ranking-a-stale-revision-vector",
      "unsealed-background-debt",
      "moving-work-outside-the-create-to-semantic-to-query-accounting-window",
      "candidate-name-or-test-wrapper-behavior",
      "benchmark-only-cache-or-runner-only-scheduling"
    ]
  },
