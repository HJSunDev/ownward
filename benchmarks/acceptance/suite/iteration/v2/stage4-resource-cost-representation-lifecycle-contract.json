  "purpose": "Prove whether a versioned pending-to-ready retrieval representation can remove synchronous raw-document inference from the create-to-semantic-to-query critical path without changing external product semantics or moving unsealed work outside accounting.",
  "external_product_contract": {
    "preserve": [
      "authority fact and revision identity",
      "explicit contexts and relations",
      "semantic work count and per-work authoritative body",
      "public semantic submission validation",
      "required fact delivery and final answers",
      "time and conflict behavior",
      "search, evidence and read limits",
      "failure-open lexical degradation",
      "durability, rebuild and restart recovery"
    ],
    "not_frozen_internal_details": [
      "semantic candidate membership and order",
      "WorkReference byte identity",
      "pending derived representation byte identity",
      "internal timing of sealed vector generation"
    ],
    "identity_rule": "Any change to an internal candidate set, WorkReference or representation creates a new V2 subject and invalidates only that subject's dependent evidence."
  },
