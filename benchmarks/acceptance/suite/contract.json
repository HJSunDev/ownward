{
  "schema": "ownward.acceptance-suite-contract/v1",
  "suite_version": "1.0.0",
  "optimization_loop": {
    "benchmark_version": "ownward-core-frontier/v1",
    "inputs": [
      "asset_snapshots",
      "change_sequences",
      "queries",
      "truth",
      "frozen_embeddings",
      "frozen_semantics",
      "deterministic_variants"
    ],
    "modes": {
      "targeted": {"max_wall_seconds": 180},
      "full": {"max_wall_seconds": 600}
    },
    "dimensions": ["quality", "latency", "resources"],
    "allow_compensating_score": false,
    "promotion": {
      "requires_no_protected_regression": true,
      "requires_predeclared_material_improvement": true,
      "requires_product_qualification": true
    },
    "external_frontier": {
      "requires_same_inputs_protocol_environment": true,
      "allow_estimated_conversion": false,
      "recalibrate_on": ["benchmark_version", "comparator_version", "environment"]
    },
    "output_schema": "ownward.frontier-report/v1"
  },
  "evidence_layers": {
    "core": {
      "version": "ownward-core-baseline/v1",
      "external_intelligence": false,
      "max_wall_seconds": 300,
      "inputs": ["candidate_manifest", "binary_manifest", "environment_manifest", "core_dataset_manifest"],
      "required_invariants": [
        "asset_preservation",
        "asset_update",
        "backup_restore",
        "derived_rebuild",
        "stable_identity",
        "disposable_derived_state",
        "replaceable_model"
      ],
      "output_schema": "ownward.core-baseline-report/v1"
    },
    "product": {
      "version": "ownward-product-dataset/v2",
      "categories": ["cross_time", "multi_hop", "context_applicability", "information_update"],
      "relation_organization_gain_required": true,
      "full_scenarios": 24,
      "full_information": 120,
      "qualification_scenarios": 8,
      "qualification_scenarios_per_category": 2,
      "modes": {
        "qualification": {"max_wall_seconds": 1800},
        "full": {"max_wall_seconds": 5400}
      },
      "inputs": ["candidate_manifest", "binary_manifest", "environment_manifest", "product_dataset_manifest"],
      "output_schema": "ownward.product-report/v1"
    },
    "community": {
      "version": "longmemeval-s/9e0b455f4ef0e2ab8f2e582289761153549043fc+d6f21ea9",
      "benchmark": "LongMemEval-S cleaned",
      "questions": 500,
      "question_types": ["single-session-user", "single-session-assistant", "single-session-preference", "multi-session", "temporal-reasoning", "knowledge-update"],
      "minimum_accuracy": 0.822,
      "capabilities": {
        "semantic": {"source": "codex", "model": "gpt-5.4-mini", "reasoning_effort": "low"},
        "reader": {"source": "codex", "model": "gpt-5.4", "reasoning_effort": "medium"},
        "judge": {"source": "official-openai", "model": "gpt-4o-2024-08-06"}
      },
      "concurrency": {"question_workers": 4, "codex_max_active": 8, "semantic_batch_size": 20, "semantic_analysis_max_input_chars": 300000},
      "cost_calibration": {"questions": 4, "semantic_batches_per_question": 3, "maximum_retry_ratio": 0.1, "requires_zero_rate_limits": true},
      "expected_wall_seconds": {"calibrated_projection": 18913, "max": 28800},
      "inputs": ["candidate_manifest", "binary_manifest", "environment_manifest", "official_dataset_manifest", "adapter_manifest"],
      "output_schema": "ownward.longmemeval-report/v1"
    }
  },
  "execution": {
    "modes": ["targeted", "core", "frontier", "qualification", "full", "longmemeval", "summarize", "self-check"],
    "relationship_authority": "relationships.py",
    "binding_fields": ["schema", "suite_version", "candidate", "scopes"],
    "binding_scopes": ["frontier", "core", "product", "community"],
    "artifact_manifest_required": true,
    "stop_on": ["budget_exceeded", "binding_changed", "prerequisite_failed", "incomplete_evidence"],
    "self_check": {
      "may_use_formal_samples": false,
      "may_promote_baseline": false,
      "may_emit_acceptance_result": false
    }
  },
  "reports": {
    "frontier": {
      "schema": "ownward.frontier-report/v1",
      "required": ["schema", "suite_version", "benchmark_version", "mode", "candidate", "baseline", "environment", "inputs", "quality", "latency", "resources", "diagnostics", "decision", "started_at", "finished_at"]
    },
    "core": {
      "schema": "ownward.core-baseline-report/v1",
      "required": ["schema", "suite_version", "candidate", "binary_sha256", "environment", "inputs", "invariants", "passed", "started_at", "finished_at"]
    },
    "product": {
      "schema": "ownward.product-report/v1",
      "required": ["schema", "suite_version", "dataset_version", "mode", "candidate", "binary_sha256", "environment", "inputs", "categories", "organization_gain", "quality", "latency", "resources", "passed", "started_at", "finished_at"]
    },
    "community": {
      "schema": "ownward.longmemeval-report/v1",
      "required": ["schema", "suite_version", "official_version", "candidate", "binary_sha256", "environment", "inputs", "capabilities", "benchmark", "quality", "retrieval", "cost", "submission", "passed", "started_at", "finished_at"]
    },
    "suite": {
      "schema": "ownward.acceptance-suite-report/v1",
      "required": ["schema", "suite_version", "candidate", "binary_sha256", "environment", "inputs", "tool_sha256", "core_report_sha256", "product_report_sha256", "community_report_sha256", "passed", "created_at"]
    }
  },
  "public_artifacts": ["contract", "datasets", "truth", "scorers", "configuration", "manifests", "reports", "raw_evidence"],
  "forbidden": ["dynamic_post_freeze_generation", "test_only_product_path", "compensating_score", "selective_rerun", "formal_result_from_self_check"]
}
